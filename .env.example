# Copy to `.env` at the repository root for local development:  cp .env.example .env
# Values here are safe placeholders. Never commit a real `.env`.

# --- Backend (Django) ------------------------------------------------------
DJANGO_SECRET_KEY=change-me-dev-only-insecure-key
# Comma-separated. Required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send CSRF-protected requests (required in production).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_ADMIN_URL=admin/
LOG_LEVEL=INFO
# "console" for humans, "json" for log aggregation (production default).
LOG_FORMAT=console
# Public URL of the web app, used in emails (password reset, invitations).
FRONTEND_URL=http://localhost:3000
# Email delivery. consolemail:// prints emails to the backend log.
# Production example: smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=consolemail://
# DEFAULT_FROM_EMAIL=AI Marketing Cloud <no-reply@example.com>
# Trusted reverse proxies in front of Django (the Next.js server counts as one in
# production). Used to derive client IPs for rate limiting.
NUM_PROXIES=0

# Host ports below match docker-compose.yml (15432/16379 avoid clashing with
# a locally installed PostgreSQL/Redis on the default ports).
DATABASE_URL=postgres://amc:amc@localhost:15432/amc
REDIS_URL=redis://localhost:16379/0
# Defaults to REDIS_URL when unset.
# CELERY_BROKER_URL=redis://localhost:16379/1

# --- Media storage ---------------------------------------------------------
# "local" (development, files under backend/media) or "s3" (any S3-compatible store).
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=        # e.g. for MinIO / Cloudflare R2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SIGNED_URL_TTL=600

# --- AI ----------------------------------------------------------------------
# "anthropic" or "mock". Development defaults to the labelled mock when no key is set;
# production refuses "mock".
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_USE_REFUSAL_FALLBACK=true

# --- Social platforms -----------------------------------------------------------
# Real integrations need an app registered with each platform (docs/integrations/).
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v26.0
# Request ads permissions and show ad accounts (on by default in development).
# META_ADS_ENABLED=false
# Random string you also enter as the webhook verify token in the Meta app.
# META_WEBHOOK_VERIFY_TOKEN=
# META_USAGE_THROTTLE_PERCENT=90
# META_TOKEN_WARNING_DAYS=7
# ADS_INSIGHTS_DAYS=30
# ADS_SPEND_DATA_MAX_AGE_HOURS=24
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Simulation accounts (never post anything). Enabled by default only in development.
# SOCIAL_MOCK_ENABLED=true
# Fernet keys for encrypting platform tokens; required in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SOCIAL_TOKEN_ENCRYPTION_KEYS=

# --- Default per-organization limits ---------------------------------------
# LIMIT_AI_REQUESTS_PER_MONTH=500
# LIMIT_AI_COST_PER_MONTH_USD=25
# LIMIT_STORAGE_BYTES=1073741824
# LIMIT_PUBLISHES_PER_DAY=25

# --- Operations thresholds (defaults are fine) ---------------------------------
# OPERATIONS_HEARTBEAT_STALE_SECONDS=180
# AI_RUN_RESUBMIT_AFTER_MINUTES=10
# AI_RUN_QUEUE_TIMEOUT_MINUTES=60
# AI_RUN_TIMEOUT_MINUTES=20
# AUTOMATION_ACTION_STUCK_MINUTES=15

# --- Frontend (Next.js) ----------------------------------------------------
# Where the Next.js server proxies /api/* requests. Read by next.config.ts.
BACKEND_INTERNAL_URL=http://localhost:8000

# --- Docker Compose host ports ---------------------------------------------
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379

# --- Content studio (ADR 0015) ---
# Image generation: "none" (default in production), "mock" (labelled placeholders; dev default).
# IMAGE_PROVIDER=none
# IMAGE_COST_PER_IMAGE_USD=0.04
# Video/audio library uploads and server-side video rendering (needs ffmpeg in the worker).
# MAX_MEDIA_UPLOAD_BYTES=104857600
# MAX_MEDIA_DURATION_SECONDS=600
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe
# VIDEO_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# VIDEO_RENDER_TIMEOUT_SECONDS=600
# Frontend proxy body limit; keep it above MAX_MEDIA_UPLOAD_BYTES.
# MAX_PROXY_BODY_SIZE=105mb
